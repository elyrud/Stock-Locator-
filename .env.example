# These are deployment settings, not credentials. Set them as environment variables.
# The local launcher uses localhost:3000 with data in ./data.
# For hosted use, create the first administrator locally BEFORE setting APP_ORIGIN.
# APP_ORIGIN=https://stock.your-domain.example
# HOST=0.0.0.0
# PORT=3000
# DATA_DIR=/persistent-data/bec-tech
